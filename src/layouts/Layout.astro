---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Vivir, pensar y crear siendo neurodivergente." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Victorinisimo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --cream: #F5F2EC;
        --ink: #1A1714;
        --ink-muted: #6B6560;
        --ink-faint: #B8B3AC;
        --accent: #C8432A;
        --font-display: 'Playfair Display', Georgia, serif;
        --font-body: 'DM Sans', system-ui, sans-serif;
        --grid-color: rgba(26, 23, 20, 0.06);
      }

      html {
        background: var(--cream);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      body {
        background-color: var(--cream);
        background-image:
          linear-gradient(var(--grid-color) 1px, transparent 1px),
          linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
        background-size: 40px 40px;
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* ══ EMOJIS CAYENDO ══ */
      .flores-global {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }
      .flor-g {
        position: absolute;
        top: calc(var(--size) * -2px);
        left: var(--x);
        font-size: var(--size);
        line-height: 1;
        opacity: 0;
        animation: flotar-g linear infinite;
        animation-delay: var(--delay);
        animation-duration: var(--dur);
        user-select: none;
      }
      @keyframes flotar-g {
        0%   { transform: translateY(0) translateX(0) rotate(0deg); opacity: 0; }
        10%  { opacity: 0.45; }
        80%  { opacity: 0.35; }
        100% { transform: translateY(105vh) translateX(var(--drift)) rotate(var(--rot)); opacity: 0; }
      }

      /* Botón pausa animaciones */
      .pause-btn {
        position: fixed;
        bottom: 1.25rem;
        right: 1.25rem;
        z-index: 100;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(245,242,236,0.9);
        border: 1px solid rgba(26,23,20,0.12);
        color: var(--ink-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      }
      .pause-btn:hover {
        background: white;
        color: var(--accent);
        border-color: var(--accent);
      }

      /* Respeta preferencia del sistema */
      @media (prefers-reduced-motion: reduce) {
        .flor-g { animation: none !important; opacity: 0 !important; }
        .slide { transition: none !important; }
      }

      a { color: inherit; text-decoration: none; }
      ::selection { background: var(--accent); color: white; }
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: var(--cream); }
      ::-webkit-scrollbar-thumb { background: var(--ink-faint); border-radius: 2px; }
    </style>
  </head>
  <body>
    <div class="flores-global" id="flores-global" aria-hidden="true"></div>
    <button class="pause-btn" id="pause-flores" aria-label="Pausar animaciones" title="Pausar animaciones">
      <svg id="pause-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
      <svg id="play-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none"><polygon points="5,3 19,12 5,21"/></svg>
    </button>

    <header>
      <nav>
        <a href="/" class="logo">Victorinisimo</a>
        <ul class="nav-links">
          <li><a href="/jardin">Jardín</a></li>
          <li><a href="/cerebro">Cerebro</a></li>
          <li><a href="/estanteria">Estantería</a></li>
          <li><a href="/mis-picks">Mis picks</a></li>
          <li><a href="/trabaja-conmigo" class="nav-wm">Trabaja conmigo</a></li>
          <li><a href="/neurodiverts" class="nav-nd">Neurodiverts</a></li>
          <li><a href="/newsletter" class="nav-cta">Newsletter</a></li>
        </ul>
        <button class="hamburger" id="hamburger" aria-label="Menú">
          <span></span><span></span><span></span>
        </button>
      </nav>
      <div class="mobile-menu" id="mobile-menu">
        <a href="/jardin">Jardín</a>
        <a href="/cerebro">Cerebro</a>
        <a href="/estanteria">Estantería</a>
        <a href="/mis-picks">Mis picks</a>
        <a href="/trabaja-conmigo">Trabaja conmigo</a>
        <a href="/neurodiverts" style="color:#E8303A;font-weight:500;">Neurodiverts</a>
        <a href="/newsletter" class="mobile-cta">Newsletter</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

