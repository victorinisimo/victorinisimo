---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Vivir, pensar y crear siendo neurodivergente." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Victorinisimo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --cream: #F5F2EC;
        --ink: #1A1714;
        --ink-muted: #6B6560;
        --ink-faint: #B8B3AC;
        --accent: #C8432A;
        --font-display: 'Playfair Display', Georgia, serif;
        --font-body: 'DM Sans', system-ui, sans-serif;
        --grid-color: rgba(26, 23, 20, 0.06);
      }

      html {
        background: var(--cream);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      body {
        background-color: var(--cream);
        background-image:
          linear-gradient(var(--grid-color) 1px, transparent 1px),
          linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
        background-size: 40px 40px;
        min-height: 100vh;
      }

      a { color: inherit; text-decoration: none; }

      ::selection { background: var(--accent); color: white; }
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: var(--cream); }
      ::-webkit-scrollbar-thumb { background: var(--ink-faint); border-radius: 2px; }
    </style>
  <style>
    #title-block { position: absolute !important; left: 0 !important; bottom: 28% !important; z-index: 10 !important; max-width: 42% !important; }
    #posts-col { display: flex !important; flex-direction: column !important; gap: 0.5rem !important; position: absolute !important; right: 0 !important; top: 50% !important; transform: translateY(-50%) !important; z-index: 10 !important; width: 220px !important; }
    #hero { position: relative !important; height: calc(100vh - 56px) !important; }
    #avatar { position: absolute !important; bottom: 0 !important; left: 50% !important; transform: translateX(-50%) !important; height: calc(100% + 56px) !important; width: auto !important; z-index: 1 !important; pointer-events: none !important; object-fit: contain !important; object-position: bottom center !important; }
  </style>
</head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">Victorinisimo</a>
        <ul>
          <li><a href="/jardin">Jardín</a></li>
          <li><a href="/cerebro">Cerebro</a></li>
          <li><a href="/estanteria">Estantería</a></li>
          <li><a href="/colaboraciones">Colaboraciones</a></li>
          <li><a href="/newsletter" class="nav-cta">Newsletter</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <span class="footer-logo">Victorinisimo</span>
        <p>cerebro neurodivergente, escritura real.</p>
        <div class="footer-links">
          <a href="/newsletter">Newsletter</a>
          <a href="/feed.xml">RSS</a>
          <a href="mailto:hola@victorinisimo.com">Contacto</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(245, 242, 236, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(26, 23, 20, 0.08);
  }

  nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-style: italic;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  ul a {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    letter-spacing: 0.03em;
    transition: color 0.15s;
  }

  ul a:hover { color: var(--ink); }

  .nav-cta {
    font-weight: 500 !important;
    color: var(--accent) !important;
    border: 1px solid var(--accent);
    padding: 0.3rem 0.9rem;
    border-radius: 2px;
    transition: all 0.15s !important;
  }

  .nav-cta:hover {
    background: var(--accent) !important;
    color: white !important;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  footer {
    margin-top: 6rem;
    border-top: 1px solid rgba(26, 23, 20, 0.1);
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 1rem;
    color: var(--ink);
  }

  footer p {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    flex: 1;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    transition: color 0.15s;
  }

  .footer-links a:hover { color: var(--ink); }
</style>