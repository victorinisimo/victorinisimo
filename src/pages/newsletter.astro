---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Newsletter">
  <div class="nl">
    <p class="nl-tag">Newsletter</p>
    <h1>El jardín llega a tu<br/><em>bandeja de entrada.</em></h1>
    <p class="nl-lead">Sin algoritmos, sin ruido. Solo lo que escribo cuando algo me obsesiona de verdad. Sin spam. Baja cuando quieras.</p>
    <form action="/api/subscribe" method="POST" class="nl-form">
      <input type="email" name="email" placeholder="tu@email.com" required />
      <button type="submit">Suscribirme gratis</button>
    </form>
    <p class="nl-nota">Sin spam. Baja cuando quieras. Exactamente como somos.</p>
  </div>
</Layout>
<style>
  .nl { max-width: 580px; padding: 4rem 0; }
  .nl-tag { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.12em; color: #B8B3AC; margin-bottom: 0.75rem; display: block; }
  .nl h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: #1A1714; line-height: 1.1; margin-bottom: 1.25rem; letter-spacing: -0.02em; }
  .nl h1 em { font-style: italic; font-weight: 400; color: #C8432A; }
  .nl-lead { font-size: 1.0625rem; color: #6B6560; line-height: 1.75; margin-bottom: 2rem; }
  .nl-form { display: flex; border: 1px solid rgba(26,23,20,0.15); border-radius: 3px; overflow: hidden; background: white; max-width: 460px; margin-bottom: 1rem; }
  .nl-form input { flex: 1; padding: 0.875rem 1rem; font-size: 0.9375rem; border: none; outline: none; background: transparent; color: #1A1714; min-width: 0; }
  .nl-form button { padding: 0.875rem 1.5rem; background: #1A1714; color: #F5F2EC; font-size: 0.875rem; font-weight: 500; border: none; cursor: pointer; white-space: nowrap; }
  .nl-form button:hover { background: #C8432A; }
  .nl-nota { font-size: 0.75rem; color: #B8B3AC; font-style: italic; }
</style>