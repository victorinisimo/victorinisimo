    <script>
      // 🌸🌷🌺🍃 cayendo
      (function() {
        var emojis = ['🌸', '🌷', '🌺', '🍃'];
        var c = document.getElementById('flores-global');
        if (!c) return;
        for (var i = 0; i < 16; i++) {
          var size = (14 + (i % 3) * 4) + 'px';
          var el = document.createElement('div');
          el.className = 'flor-g';
          el.textContent = emojis[i % 4];
          var xPos = ((i * 6.25 + 2) % 100) + '%';
          var delay = (i * 1.8).toFixed(1) + 's';
          var dur = (20 + (i % 6)) + 's';
          var drift = (((i * 31) % 40) - 20) + 'px';
          var rot = ((i * 47) % 180) + 'deg';
          el.style.cssText = '--x:'+xPos+';--delay:'+delay+';--dur:'+dur+';--drift:'+drift+';--rot:'+rot+';--size:'+size+';';
          c.appendChild(el);
        }
      })();
    </script>

    <script>
      // Botón pausa flores
      (function() {
        var btn = document.getElementById('pause-flores');
        var container = document.getElementById('flores-global');
        var pauseIcon = document.getElementById('pause-icon');
        var playIcon = document.getElementById('play-icon');
        var paused = false;

        if (!btn) return;

        btn.addEventListener('click', function() {
          paused = !paused;
          if (paused) {
            container.style.animationPlayState = 'paused';
            // Pausa cada flor individualmente
            var flores = container.querySelectorAll('.flor-g');
            flores.forEach(function(f) { f.style.animationPlayState = 'paused'; });
            pauseIcon.style.display = 'none';
            playIcon.style.display = 'block';
            btn.title = 'Reanudar animaciones';
            btn.setAttribute('aria-label', 'Reanudar animaciones');
          } else {
            var flores = container.querySelectorAll('.flor-g');
            flores.forEach(function(f) { f.style.animationPlayState = 'running'; });
            pauseIcon.style.display = 'block';
            playIcon.style.display = 'none';
            btn.title = 'Pausar animaciones';
            btn.setAttribute('aria-label', 'Pausar animaciones');
          }
        });
      })();
    </script>

    <script>
      // Año dinámico
      const yearEl = document.getElementById('footer-year');
      if (yearEl) yearEl.textContent = '© ' + new Date().getFullYear() + ' Victorinisimo';
    </script>

    <script>
      const hamburger = document.getElementById('hamburger');
      const menu = document.getElementById('mobile-menu');
      hamburger?.addEventListener('click', () => {
        menu?.classList.toggle('open');
        hamburger?.classList.toggle('open');
      });
    </script>
  </body>
