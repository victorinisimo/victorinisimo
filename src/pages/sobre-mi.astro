---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Sobre mí">
  <div class="sobre">
    <p class="sobre-tag">Sobre mí</p>
    <h1>Soy Victorino.<br/><em>AuDHD, creador y fundador de Neurodiverts.</em></h1>
    <p class="sobre-lead">Escribo sobre lo que me obsesiona — fermentados, skincare coreano, microbiota, productividad con IA y lo que significa vivir con un cerebro neurodivergente. Sin filtros. Sin perfección. Exactamente como somos.</p>
    <div class="sobre-links">
      <a href="/jardin" class="sobre-btn">Leer el jardín →</a>
      <a href="/neurodiverts" class="sobre-btn-ghost">Conocer Neurodiverts →</a>
    </div>
  </div>
</Layout>
<style>
  .sobre { max-width: 680px; padding: 4rem 0; }
  .sobre-tag { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.12em; color: #B8B3AC; margin-bottom: 0.75rem; display: block; }
  .sobre h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: #1A1714; line-height: 1.1; margin-bottom: 1.5rem; letter-spacing: -0.02em; }
  .sobre h1 em { font-style: italic; font-weight: 400; color: #C8432A; }
  .sobre-lead { font-size: 1.0625rem; color: #6B6560; line-height: 1.75; margin-bottom: 2rem; }
  .sobre-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .sobre-btn { display: inline-flex; align-items: center; height: 44px; padding: 0 1.5rem; background: #C8432A; color: white !important; font-size: 0.875rem; font-weight: 500; border-radius: 3px; }
  .sobre-btn-ghost { display: inline-flex; align-items: center; height: 44px; padding: 0 1.5rem; border: 1px solid rgba(26,23,20,0.2); color: #1A1714 !important; font-size: 0.875rem; border-radius: 3px; }
</style>