<style>
  header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: rgba(245, 242, 236, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(26, 23, 20, 0.08);
  }

  nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    font-style: italic;
    color: var(--ink);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-links { list-style: none; display: flex; gap: 1.5rem; align-items: center; }
  .nav-links a { font-size: 0.8125rem; color: var(--ink-muted); letter-spacing: 0.03em; transition: color 0.15s; white-space: nowrap; }
  .nav-links a:hover { color: var(--ink); }

  .nav-cta {
    font-weight: 500 !important;
    color: var(--accent) !important;
    border: 1px solid var(--accent);
    padding: 0.3rem 0.9rem;
    border-radius: 2px;
    transition: all 0.15s !important;
  }
  .nav-cta:hover { background: var(--accent) !important; color: white !important; }

  .nav-nd {
    color: #E8303A !important;
    font-weight: 500;
  }
  .nav-nd:hover { color: #c42030 !important; }
  .nav-wm { color: var(--ink-muted) !important; font-weight: 500; }
  .nav-wm:hover { color: var(--ink) !important; }

  .hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .hamburger span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; transition: all 0.2s; }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu { display: none; flex-direction: column; background: rgba(245,242,236,0.98); border-top: 1px solid rgba(26,23,20,0.08); padding: 1rem 1.5rem; gap: 0; position: relative; z-index: 200; }
  .mobile-menu.open { display: flex; }
  .mobile-menu a { font-size: 1rem; color: var(--ink-muted); padding: 0.75rem 0; border-bottom: 1px solid rgba(26,23,20,0.06); transition: color 0.15s; }
  .mobile-menu a:hover { color: var(--ink); }
  .mobile-menu a:last-child { border-bottom: none; }
  .mobile-cta { color: var(--accent) !important; font-weight: 500; }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
  }

  main { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  @media (max-width: 599px) { main { padding: 0 1rem; } }

  footer { margin-top: 4rem; border-top: 1px solid rgba(26,23,20,0.1); position: relative; z-index: 10; }
  .footer-inner { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  @media (max-width: 599px) { .footer-inner { padding: 1.5rem 1rem; } }
  .footer-top { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .footer-logo { font-family: var(--font-display); font-weight: 700; font-style: italic; font-size: 1rem; color: var(--ink); white-space: nowrap; }
  .footer-tagline { font-size: 0.8125rem; color: var(--ink-muted); font-style: italic; }
  .footer-social { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .footer-social a { color: var(--ink-faint); transition: color 0.15s; display: flex; align-items: center; padding: 4px; }
  .footer-social a:hover { color: var(--accent); }
  .footer-bottom { border-top: 1px solid rgba(26,23,20,0.06); padding-top: 1rem; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; }
  @media (max-width: 599px) { .footer-bottom { flex-direction: column; align-items: flex-start; } }
  .footer-copy { font-size:0.75rem; color:var(--ink-faint); }
  .footer-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .footer-links a { font-size: 0.75rem; color: var(--ink-muted); transition: color 0.15s; }
  .footer-links a:hover { color: var(--ink); }
</style>