---
import Layout from '../layouts/Layout.astro';

const posts = [
  { slug: "por-que-escribir", title: "Por qué escribir me ayuda a procesar el mundo", category: "El jardín", date: "28 mar 2026", desc: "La escritura como prótesis, como resistencia, como la única forma de convertir el glitch permanente que soy en algo con lo que se pueda vivir." },
];
---

<Layout title="El jardín">

  <section class="hero-break">
    <div class="hero-inner">
      <div class="avatar-shell">
        <video src="/videos/avatar-walk.mp4" autoplay loop muted playsinline preload="auto" class="avatar-vid"></video>
      </div>
      <div class="text-col">
        <p class="section-label">El jardín</p>
        <h1>Escritura, vlogs<br/><em>e historias.</em></h1>
        <p class="header-desc">Todo lo que escribo cuando algo me obsesiona. Sin filtros, sin perfección, con todo el caos organizado de un cerebro neurodivergente.</p>
      </div>
    </div>
  </section>

  <section class="garden-section">
    <div class="posts-grid">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="post-row">
          <span class="post-date">{post.date}</span>
          <div class="post-info">
            <span class="post-cat">{post.category}</span>
            <span class="post-title">{post.title}</span>
            <span class="post-desc">{post.desc}</span>
          </div>
          <span class="post-arrow">→</span>
        </a>
      ))}
    </div>
    <div class="garden-empty">
      <p class="empty-quote">Más entradas próximamente.</p>
    </div>
  </section>

</Layout>

<style>
  /* ══ HERO ══ */
  .hero-break {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: calc(100vh - 56px);
    min-height: 400px;
    overflow: hidden;
    position: relative;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    height: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    gap: 3rem;
  }

  /* Móvil */
  @media (max-width: 599px) {
    .hero-break { width: 100%; margin-left: 0; height: auto; min-height: 0; }
    .hero-inner { grid-template-columns: 1fr; padding: 1.5rem 1rem; gap: 1rem; }
    .avatar-shell { width: 100%; max-width: 100%; height: 65vw; }
  }

  /* Tablet */
  @media (min-width: 600px) and (max-width: 1024px) {
    .hero-inner { gap: 2rem; }
    .avatar-shell { max-width: 260px; }
  }

  /* ══ AVATAR ══ */
  .avatar-shell {
    position: relative;
    height: 100%;
    width: calc((100vh - 56px) * 9 / 16);
    max-width: 340px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .avatar-vid {
    width: 100%; height: 100%;
    object-fit: contain;
    object-position: center bottom;
    display: block;
    mix-blend-mode: multiply;
  }

  /* ══ TEXTO ══ */
  .section-label { font-size: 0.5625rem; text-transform: uppercase; letter-spacing: 0.12em; color: #B8B3AC; margin-bottom: 1rem; display: block; }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 900; line-height: 1;
    letter-spacing: -0.02em; color: #1A1714; margin-bottom: 0.75rem;
  }
  h1 em { font-style: italic; font-weight: 400; }

  .header-desc { font-size: clamp(0.875rem, 2vw, 1rem); color: #6B6560; line-height: 1.7; max-width: 440px; }

  /* ══ POSTS ══ */
  .garden-section { border-top: 1px solid rgba(26,23,20,0.08); padding: 2rem 0 4rem; }
  .posts-grid { display: grid; gap: 1px; border: 1px solid rgba(26,23,20,0.08); border-radius: 4px; overflow: hidden; background: rgba(26,23,20,0.06); }

  .post-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    background: #F5F2EC;
    transition: background 0.15s;
    text-decoration: none;
  }
  @media (max-width: 599px) {
    .post-row { grid-template-columns: 1fr auto; gap: 0.75rem; padding: 1rem; }
    .post-date { display: none; }
  }
  .post-row:hover { background: white; }

  .post-date { font-size: 0.6875rem; color: #B8B3AC; white-space: nowrap; }
  .post-info { display: flex; flex-direction: column; gap: 0.25rem; }
  .post-cat { font-size: 0.5625rem; text-transform: uppercase; letter-spacing: 0.1em; color: #C8432A; font-weight: 500; display: block; }
  .post-title { font-size: clamp(0.875rem, 2vw, 1rem); font-weight: 500; color: #1A1714; font-family: 'Playfair Display', serif; }
  .post-desc { font-size: 0.8125rem; color: #6B6560; line-height: 1.5; }
  @media (max-width: 599px) { .post-desc { display: none; } }
  .post-arrow { color: #B8B3AC; font-size: 1rem; }

  .garden-empty { text-align: center; padding: 3rem 0 2rem; }
  .empty-quote { font-family: 'Playfair Display', serif; font-size: 1.25rem; font-style: italic; color: #B8B3AC; }
</style>