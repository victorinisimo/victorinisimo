---
import Layout from '../layouts/Layout.astro';

const posts = [
  { slug: "por-que-escribir", title: "Por qué escribir me ayuda a procesar el mundo", category: "El jardín", date: "28 mar 2026" },
];
---

<Layout title="inicio">

  <!-- ═══════════════════════════════════
       MÓVIL: layout vertical simple
  ═══════════════════════════════════ -->
  <section class="hero-mobile">
    <div class="mob-avatar">
      <img src="/avatar.png" alt="Victorino" />
    </div>
    <div class="mob-content">
      <h1>
        <span class="t1">EL JARDÍN</span>
        <span class="t2">digital de</span>
        <span class="t3">VICTORINISIMO</span>
      </h1>
      <p class="sub">Escritura · Vida · Cerebro neurodivergente</p>
      <div class="cta">
        <a href="/newsletter" class="btn-red">Suscribirme gratis</a>
        <a href="/jardin" class="btn-ghost">Leer el jardín</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       ESCRITORIO: layout Avatar.Studio
  ═══════════════════════════════════ -->
  <section class="hero-desk">
    <img
      id="avatar"
      src="/avatar.png"
      alt="Victorino"
      class="avatar"
    />
    <div class="title-block">
      <h1>
        <span class="t1">EL JARDÍN</span>
        <span class="t2">digital de</span>
        <span class="t3">VICTORINISIMO</span>
      </h1>
      <p class="sub">Escritura · Vida · Cerebro neurodivergente</p>
      <div class="cta">
        <a href="/newsletter" class="btn-red">Suscribirme gratis</a>
        <a href="/jardin" class="btn-ghost">Leer el jardín</a>
      </div>
    </div>
    <div class="posts-col">
      <p class="posts-label">Últimas entradas</p>
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="post-card">
          <span class="post-cat">{post.category}</span>
          <span class="post-title">{post.title}</span>
          <span class="post-date">{post.date}</span>
        </a>
      ))}
      <a href="/jardin" class="ver-todos">Ver todas →</a>
    </div>
  </section>

  <!-- Categorías -->
  <section class="cats">
    <div class="cats-grid">
      {[
        { icon: "✍️", name: "El jardín", desc: "Escritura, vlogs e historias", href: "/jardin" },
        { icon: "🧠", name: "El cerebro", desc: "Vivir siendo AuDHD", href: "/cerebro" },
        { icon: "🫙", name: "La despensa", desc: "Kéfir, kimchi, kombucha", href: "/jardin?cat=fermentados" },
        { icon: "🤖", name: "El laboratorio", desc: "IA y productividad AuDHD", href: "/jardin?cat=ia" },
        { icon: "🌿", name: "La microbiota", desc: "Salud intestinal", href: "/jardin?cat=microbiota" },
        { icon: "🌸", name: "El ritual", desc: "Skincare coreano", href: "/jardin?cat=skincare" },
      ].map(cat => (
        <a href={cat.href} class="cat-card">
          <span class="cat-icon">{cat.icon}</span>
          <span class="cat-name">{cat.name}</span>
          <span class="cat-desc">{cat.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Sobre mí -->
  <section class="about">
    <div class="about-inner">
      <div class="about-text">
        <p class="about-tag">Sobre mí</p>
        <h2>Soy Victorino, AuDHD y creador de contenido</h2>
        <p>Escribo sobre lo que me obsesiona: fermentados, skincare coreano, microbiota, productividad con IA y lo que significa vivir con un cerebro neurodivergente. Sin filtros, sin perfección.</p>
        <a href="/sobre-mi" class="btn-ghost" style="margin-top:1rem;display:inline-block;">Conocerme mejor →</a>
      </div>
      <div class="about-stats">
        <div class="stat"><span class="stat-num">6</span><span class="stat-label">Temáticas</span></div>
        <div class="stat"><span class="stat-num">AuDHD</span><span class="stat-label">Diagnóstico</span></div>
        <div class="stat"><span class="stat-num">100%</span><span class="stat-label">Contenido real</span></div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter">
    <p class="newsletter-tag">Newsletter</p>
    <h2>El jardín llega a tu bandeja de entrada</h2>
    <p class="newsletter-sub">Sin algoritmos, sin ruido. Solo lo que escribo cuando algo me obsesiona de verdad.</p>
    <form action="/api/subscribe" method="POST" class="newsletter-form">
      <input type="email" name="email" placeholder="tu@email.com" required />
      <button type="submit">Suscribirme gratis</button>
    </form>
    <p class="newsletter-note">Sin spam. Baja cuando quieras.</p>
  </section>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const avatar = document.getElementById('avatar');
    if (!avatar) return;
    document.addEventListener('mousemove', (e) => {
      const rect = avatar.getBoundingClientRect();
      const rotateY = ((e.clientX - (rect.left + rect.width / 2)) / window.innerWidth) * 15;
      const rotateX = -((e.clientY - (rect.top + rect.height / 2)) / window.innerHeight) * 10;
      avatar.style.transform = `translateX(-50%) perspective(800px) rotateY(${rotateY}deg) rotateX(${rotateX}deg)`;
      avatar.style.transition = 'transform 0.1s ease-out';
    });
    document.addEventListener('mouseleave', () => {
      avatar.style.transform = 'translateX(-50%)';
      avatar.style.transition = 'transform 0.5s ease-out';
    });
  });
</script>

<style>
  /* ══ TIPOGRAFÍA COMPARTIDA ══ */
  h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #1A1714;
    display: flex;
    flex-direction: column;
  }
  .t1 { font-size: clamp(1.75rem, 4vw, 2.75rem); white-space: nowrap; display: block; }
  .t2 { font-size: clamp(1.25rem, 3vw, 2rem); font-style: italic; font-weight: 400; color: #6B6560; white-space: nowrap; display: block; }
  .t3 { font-size: clamp(1.5rem, 4.5vw, 2.9rem); white-space: nowrap; letter-spacing: -0.03em; display: block; }
  .sub { font-size: 0.875rem; color: #6B6560; margin-top: 0.875rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .btn-red { display: inline-block; padding: 0.65rem 1.35rem; background: #C8432A; color: white !important; font-size: 0.8125rem; font-weight: 500; border-radius: 2px; }
  .btn-ghost { display: inline-block; padding: 0.65rem 1.35rem; border: 1px solid rgba(26,23,20,0.2); color: #1A1714 !important; font-size: 0.8125rem; border-radius: 2px; }

  /* ══ HERO MÓVIL ══ */
  .hero-desk { display: none; }

  .hero-mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 2rem;
  }

  .mob-avatar {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
    max-height: 420px;
  }

  .mob-avatar img {
    height: 420px;
    width: auto;
    object-fit: contain;
    object-position: top center;
  }

  .mob-content {
    width: 100%;
    padding-top: 1rem;
  }

  /* ══ HERO ESCRITORIO ══ */
  @media (min-width: 768px) {
    .hero-mobile { display: none; }
    .hero-desk {
      display: block;
      position: relative;
      height: calc(100vh - 56px);
      overflow: visible;
    }

    .avatar {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      height: calc(100% + 56px);
      width: auto;
      object-fit: contain;
      object-position: bottom center;
      z-index: 1;
      pointer-events: none;
    }

    .title-block {
      position: absolute;
      left: 0;
      bottom: 28%;
      z-index: 2;
      max-width: 40%;
    }

    .posts-col {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      width: 220px;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  /* Posts */
  .posts-label { font-size: 0.5625rem; text-transform: uppercase; letter-spacing: 0.12em; color: #B8B3AC; margin-bottom: 0.25rem; }
  .post-card { display: flex; flex-direction: column; gap: 3px; padding: 0.75rem; border: 1px solid rgba(26,23,20,0.08); border-radius: 2px; background: rgba(245,242,236,0.9); }
  .post-cat { font-size: 0.5625rem; letter-spacing: 0.06em; color: #C8432A; font-weight: 500; }
  .post-title { font-size: 0.75rem; color: #1A1714; line-height: 1.4; }
  .post-date { font-size: 0.5625rem; color: #B8B3AC; }
  .ver-todos { font-size: 0.75rem; color: #6B6560; padding: 0.4rem 0; text-align: right; display: block; }

  /* ══ CATEGORÍAS ══ */
  .cats { padding: 2.5rem 0 0; border-top: 1px solid rgba(26,23,20,0.08); }
  .cats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; border: 1px solid rgba(26,23,20,0.1); border-radius: 4px; overflow: hidden; background: rgba(26,23,20,0.08); }
  @media (min-width: 600px) { .cats-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .cats-grid { grid-template-columns: repeat(6, 1fr); } }
  .cat-card { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.25rem 1rem; background: #F5F2EC; transition: background 0.15s; }
  .cat-card:hover { background: white; }
  .cat-icon { font-size: 1.25rem; }
  .cat-name { font-size: 0.75rem; font-weight: 500; color: #1A1714; }
  .cat-desc { font-size: 0.6875rem; color: #6B6560; line-height: 1.4; }

  /* ══ SOBRE MÍ ══ */
  .about { padding: 3rem 0; border-top: 1px solid rgba(26,23,20,0.08); }
  .about-inner { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 700px) { .about-inner { grid-template-columns: 1fr auto; align-items: center; } }
  .about-tag { font-size: 0.5625rem; text-transform: uppercase; letter-spacing: 0.12em; color: #B8B3AC; margin-bottom: 0.75rem; }
  .about-text h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.25rem, 2.5vw, 1.75rem); font-weight: 700; font-style: italic; line-height: 1.2; margin-bottom: 0.75rem; color: #1A1714; }
  .about-text p { font-size: 0.9375rem; color: #6B6560; line-height: 1.7; max-width: 540px; }
  .about-stats { display: flex; gap: 2rem; }
  @media (min-width: 700px) { .about-stats { flex-direction: column; gap: 1.5rem; align-items: flex-end; } }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  @media (min-width: 700px) { .stat { align-items: flex-end; } }
  .stat-num { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 900; color: #1A1714; line-height: 1; }
  .stat-label { font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.1em; color: #B8B3AC; }

  /* ══ NEWSLETTER ══ */
  .newsletter { padding: 3rem 0; border-top: 1px solid rgba(26,23,20,0.08); text-align: center; }
  .newsletter-tag { font-size: 0.5625rem; text-transform: uppercase; letter-spacing: 0.12em; color: #B8B3AC; margin-bottom: 0.75rem; }
  .newsletter h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700; font-style: italic; color: #1A1714; margin-bottom: 0.75rem; }
  .newsletter-sub { font-size: 0.9375rem; color: #6B6560; max-width: 480px; margin: 0 auto 2rem; line-height: 1.7; }
  .newsletter-form { display: flex; max-width: 420px; margin: 0 auto; border: 1px solid rgba(26,23,20,0.15); border-radius: 2px; overflow: hidden; background: white; }
  .newsletter-form input { flex: 1; padding: 0.75rem 1rem; font-size: 0.875rem; border: none; outline: none; background: transparent; color: #1A1714; min-width: 0; }
  .newsletter-form button { padding: 0.75rem 1.25rem; background: #1A1714; color: #F5F2EC; font-size: 0.8125rem; font-weight: 500; border: none; cursor: pointer; white-space: nowrap; }
  .newsletter-note { font-size: 0.6875rem; color: #B8B3AC; margin-top: 0.75rem; }
</style>