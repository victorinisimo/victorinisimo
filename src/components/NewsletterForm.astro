---
// NewsletterForm.astro
// Integración con Resend (resend.com) para capturar emails
// Setup: npm install resend
// Añade RESEND_API_KEY en .env y en Cloudflare Pages → Settings → Variables

export interface Props {
  variant?: 'inline' | 'full';
}

const { variant = 'inline' } = Astro.props;

// Manejo del form en el servidor (Astro SSR o endpoint)
// Para SSR: añade output: 'hybrid' en astro.config.mjs y crea src/pages/api/subscribe.ts
---

<div class={`newsletter-wrap ${variant}`}>
  {variant === 'full' && (
    <div class="newsletter-header">
      <h2>Únete al caos organizado</h2>
      <p>Escritura neurodivergente, fermentados, skincare coreano y lo que me esté obsesionando esta semana. Sin algoritmos. Sin spam. Solo tú y yo.</p>
    </div>
  )}

  <form
    id="newsletter-form"
    class="newsletter-form"
    action="/api/subscribe"
    method="POST"
  >
    <div class="form-row">
      <input
        type="email"
        name="email"
        placeholder="tu@email.com"
        required
        autocomplete="email"
      />
      <button type="submit">
        <span class="btn-text">suscribirme</span>
        <span class="btn-loading" aria-hidden="true">···</span>
      </button>
    </div>
    <p class="form-note">Sin spam. Baja cuando quieras.</p>

    <!-- Estados de respuesta -->
    <div id="form-success" class="form-message success" aria-live="polite" hidden>
      ¡Apuntado! Revisa tu email para confirmar.
    </div>
    <div id="form-error" class="form-message error" aria-live="polite" hidden>
      Algo fue mal. Inténtalo de nuevo.
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.classList.add('loading');
    btn.disabled = true;

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        body: JSON.stringify({ email: formData.get('email') }),
        headers: { 'Content-Type': 'application/json' },
      });

      if (res.ok) {
        form.querySelector('.form-row')?.setAttribute('hidden', '');
        successMsg?.removeAttribute('hidden');
      } else {
        throw new Error('Error en servidor');
      }
    } catch {
      errorMsg?.removeAttribute('hidden');
      btn.classList.remove('loading');
      btn.disabled = false;
    }
  });
</script>

<style>
  .newsletter-wrap {
    padding: 2rem;
    border: 1px solid rgba(26, 23, 20, 0.1);
    border-radius: 2px;
    background: rgba(245, 242, 236, 0.8);
  }

  .newsletter-wrap.full {
    padding: 3rem;
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-header h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .newsletter-header p {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .form-row {
    display: flex;
    gap: 0;
    border: 1px solid rgba(26, 23, 20, 0.15);
    border-radius: 2px;
    overflow: hidden;
    background: white;
  }

  input[type="email"] {
    flex: 1;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    border: none;
    outline: none;
    background: transparent;
    color: var(--ink);
    min-width: 0;
  }

  input[type="email"]::placeholder { color: var(--ink-faint); }

  button {
    padding: 0.75rem 1.25rem;
    background: var(--ink);
    color: var(--cream);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    border: none;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
    position: relative;
  }

  button:hover { background: var(--accent); }

  .btn-loading { display: none; }

  button.loading .btn-text { display: none; }
  button.loading .btn-loading {
    display: inline;
    animation: blink 1s step-start infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .form-note {
    font-size: 0.6875rem;
    color: var(--ink-faint);
    margin-top: 0.5rem;
  }

  .form-message {
    font-size: 0.875rem;
    padding: 0.75rem 1rem;
    border-radius: 2px;
    margin-top: 0.75rem;
  }

  .form-message.success {
    background: #EDF7ED;
    color: #2D6A2D;
    border: 1px solid #B8DDB8;
  }

  .form-message.error {
    background: #FDF0EE;
    color: var(--accent);
    border: 1px solid #F0C8C0;
  }
</style>
