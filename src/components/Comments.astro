---
// Comments.astro — comentarios con Giscus (GitHub Discussions)
//
// SETUP (5 minutos):
// 1. Ve a https://github.com/apps/giscus e instálalo en tu repo
// 2. Ve a https://giscus.app/ y rellena tu repo para obtener los IDs
// 3. Reemplaza los valores de abajo con los tuyos
// 4. En tu repo GitHub: Settings → Features → activa Discussions

export interface Props {
  title: string; // título del post (para mapear al thread correcto)
}

const { title } = Astro.props;

// ⚠️ REEMPLAZA ESTOS VALORES con los de https://giscus.app/
const GISCUS_REPO = "tuusuario/victorinisimo";          // tu usuario/repo
const GISCUS_REPO_ID = "R_XXXXXXXX";                    // de giscus.app
const GISCUS_CATEGORY = "Comentarios";                  // nombre de la categoría
const GISCUS_CATEGORY_ID = "DIC_XXXXXXXX";              // de giscus.app
---

<section class="comments-section">
  <div class="comments-header">
    <h3>comentarios</h3>
    <p>
      Los comentarios van con tu cuenta de GitHub.
      <a href="https://github.com/login" target="_blank" rel="noopener">
        Iniciar sesión →
      </a>
    </p>
  </div>

  <div class="giscus-wrap">
    <script
      src="https://giscus.app/client.js"
      data-repo={GISCUS_REPO}
      data-repo-id={GISCUS_REPO_ID}
      data-category={GISCUS_CATEGORY}
      data-category-id={GISCUS_CATEGORY_ID}
      data-mapping="title"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="es"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </div>

  <p class="comments-note">
    ¿Sin cuenta de GitHub?
    <a href="/newsletter">Suscríbete a la newsletter</a>
    para unirte a la conversación por email.
  </p>
</section>

<style>
  .comments-section {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(26, 23, 20, 0.08);
  }

  .comments-header {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .comments-header h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    font-style: italic;
  }

  .comments-header p {
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .comments-header a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .giscus-wrap {
    /* Giscus inyecta su iframe aquí */
    min-height: 200px;
  }

  /* Estilos para el iframe de Giscus (tema light, fondo crema) */
  :global(.giscus-frame) {
    width: 100%;
    border: none;
  }

  .comments-note {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .comments-note a {
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .comments-note a:hover { color: var(--accent); }
</style>
